{
  "name": "@galley/book",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3300",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3300",
    "migrate": "node --env-file-if-exists=.env.local scripts/migrate.ts",
    "key": "node --env-file-if-exists=.env.local --import ./scripts/ts-resolve.mjs scripts/key.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "galley:setup": "node scripts/setup.mjs",
    "galley:adopt": "node --env-file-if-exists=.env.local --import ./scripts/ts-resolve.mjs scripts/adopt.ts"
  },
  "dependencies": {
    "@clickhouse/client": "1.25.0",
    "@modelcontextprotocol/sdk": "1.26.0",
    "markdown-it": "14.1.0",
    "mcp-handler": "1.1.0",
    "next": "16.4.6",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/markdown-it": "14.1.2",
    "@types/node": "24.10.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "typescript": "5.9.3",
    "vitest": "4.0.8"
  }
}
